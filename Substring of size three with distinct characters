#include <string.h>

int countGoodSubstrings(char* s) {
    int len = strlen(s);
    int count = 0;
    
    // Loop through the string, stopping 2 characters before the end
    for (int i = 0; i < len - 2; i++) {
        char a = s[i];
        char b = s[i + 1];
        char c = s[i + 2];
        
        // Check if all three characters are distinct
        if (a != b && b != c && a != c) {
            count++;
        }
    }
    
    return count;
}
