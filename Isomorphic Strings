#include <stdbool.h>
#include <string.h>

bool isIsomorphic(char* s, char* t) {
    int map_s[256] = {0}, map_t[256] = {0};
    int len = strlen(s);
    
    for (int i = 0; i < len; i++) {
        if (map_s[(unsigned char)s[i]] != map_t[(unsigned char)t[i]]) {
            return false;
        }
        map_s[(unsigned char)s[i]] = i + 1;
        map_t[(unsigned char)t[i]] = i + 1;
    }
    return true;
}
