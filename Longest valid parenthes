#include <stdio.h>
#include <string.h>
#include <stdlib.h>

int longestValidParentheses(char* s) {
    int max_len = 0;
    int n = strlen(s);
    if (n == 0) return 0;
    
    // Allocate stack for indices; size n + 1
    int* stack = (int*)malloc((n + 1) * sizeof(int));
    int top = -1;
    
    // Base index for edge cases
    stack[++top] = -1;
    
    for (int i = 0; i < n; i++) {
        if (s[i] == '(') {
            stack[++top] = i;
        } else {
            top--; // Pop matching '(' or the base index
            if (top == -1) {
                // If stack is empty, push current index as new base
                stack[++top] = i;
            } else {
                int len = i - stack[top];
                if (len > max_len) {
                    max_len = len;
                }
            }
        }
    }
    
    free(stack);
    return max_len;
}

